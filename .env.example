# Required
BOT_TOKEN=put_your_bot_token_here
GUILD_ID=put_your_server_id_here
LOG_CHANNEL_ID=put_your_staff_log_channel_id_here
BOOST_CHANNEL_ID=put_your_boost_log_channel_id_here

# Optional staff role. If 0, Discord moderation permissions are used.
STAFF_ROLE_ID=0

# SQLite database
DATABASE_PATH=moderation.db

# Optional palette overrides (decimal RGB values)
# Defaults are already set for the Clouddyie's Cardboard Box aesthetic.
COLOR_BAN=14423100
COLOR_KICK=16763187
COLOR_MUTE=11513775
COLOR_WARN=16772724
COLOR_UNBAN=11976299
COLOR_HISTORY=13224393
